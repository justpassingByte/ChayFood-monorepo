datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum MenuCategory {
  MAIN
  SIDE
  DESSERT
  BEVERAGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  COD
  CARD
  BANKING
}

enum IngredientUnit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
  PORTION
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum StockTransactionType {
  IMPORT
  EXPORT_ORDER
  EXPORT_WASTE
  ADJUSTMENT
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  address      String?
  role         Role      @default(USER)
  googleId     String?   @unique
  facebookId   String?   @unique
  picture      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders              Order[]
  subscriptions       Subscription[]
  preference          UserPreference?
  ownedFamilyGroups   FamilyGroup[]  @relation("FamilyOwner")
  linkedFamilyMembers FamilyMember[] @relation("LinkedFamilyUser")

  @@map("users")
}

model MenuItem {
  id              String       @id @default(uuid())
  name            String
  description     String       @db.Text
  price           Decimal      @db.Decimal(12, 2)
  category        MenuCategory @default(MAIN)
  image           String
  calories        Int          @default(0)
  protein         Decimal      @default(0) @db.Decimal(6, 2)
  carbs           Decimal      @default(0) @db.Decimal(6, 2)
  fat             Decimal      @default(0) @db.Decimal(6, 2)
  isAvailable     Boolean      @default(true)
  preparationTime Int          @default(15) // phút
  ingredients     String[]     @default([])
  allergens       String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orderItems OrderItem[]
  tag        MenuItemTag?
  recipe     Recipe?

  @@map("menu_items")
}

model MenuItemTag {
  id              String   @id @default(uuid())
  menuItemId      String   @unique
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tags            String[] @default([])
  occasionTags    String[] @default([])
  recommendedWith String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("menu_item_tags")
}

model Plan {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  price               Decimal  @db.Decimal(12, 2)
  duration            Int      @default(7) // số ngày
  description         String   @db.Text
  mealsPerDay         Int      @default(1)
  snacksPerDay        Int      @default(0)
  features            String[] @default([])
  isRecommended       Boolean  @default(false)
  isPremiumMenu       Boolean  @default(false)
  hasDietitianSupport Boolean  @default(false)
  hasCustomization    Boolean  @default(false)
  hasPriorityDelivery Boolean  @default(false)
  has24HrSupport      Boolean  @default(false)
  isFamilyPlan        Boolean  @default(false)
  targetMembersCount  Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean       @default(true)
  deliveryAddress     Json // { street, city, state, postalCode, additionalInfo }
  selectedMenuItems   Json? // [{ menuItemId, quantity, dayOfWeek, mealType }]
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       PaymentMethod @default(CARD)
  totalAmount         Decimal       @db.Decimal(12, 2)
  specialInstructions String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("subscriptions")
}

model Order {
  id                  String        @id @default(uuid())
  sequenceNumber      Int           @default(autoincrement())
  orderNumber         String        @unique
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  totalAmount         Decimal       @db.Decimal(12, 2)
  status              OrderStatus   @default(PENDING)
  deliveryAddress     Json // { street, city, state, postalCode, additionalInfo }
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       PaymentMethod @default(COD)
  deliveryTime        DateTime?
  specialInstructions String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items                OrderItem[]
  paymentTransactions  PaymentTransaction[]

  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity            Int      @default(1)
  price               Decimal  @db.Decimal(12, 2)
  specialInstructions String?
  createdAt           DateTime @default(now())

  @@map("order_items")
}

model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteCategories  String[] @default([])
  dislikedIngredients String[] @default([])
  minProtein          Decimal? @db.Decimal(6, 2)
  maxCalories         Int?
  dietaryRestrictions String[] @default([])
  favoriteItemIds     String[] @default([])
  lastViewedItemIds   String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_preferences")
}

model Ingredient {
  id               String         @id @default(uuid())
  name             String
  code             String         @unique
  unit             IngredientUnit @default(GRAM)
  currentStock     Decimal        @default(0) @db.Decimal(12, 2)
  minThreshold     Decimal        @default(0) @db.Decimal(12, 2)
  costPerUnit      Decimal        @default(0) @db.Decimal(12, 2)
  supplier         String?
  category         String?
  isAvailable      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  recipeItems      RecipeItem[]
  transactions     StockTransaction[]

  @@map("ingredients")
}

model Recipe {
  id               String       @id @default(uuid())
  menuItemId       String       @unique
  menuItem         MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name             String
  description      String?      @db.Text
  prepTimeMinutes  Int          @default(15)
  cookTimeMinutes  Int          @default(15)
  servingSize      Int          @default(1)
  instructions     Json         @default("[]")
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items            RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id           String         @id @default(uuid())
  recipeId     String
  recipe       Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal        @db.Decimal(10, 2)
  unit         IngredientUnit @default(GRAM)
  isOptional   Boolean        @default(false)
  notes        String?
  createdAt    DateTime       @default(now())

  @@map("recipe_items")
}

model StockTransaction {
  id            String               @id @default(uuid())
  ingredientId  String
  ingredient    Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type          StockTransactionType
  quantity      Decimal              @db.Decimal(12, 2)
  previousStock Decimal              @db.Decimal(12, 2)
  newStock      Decimal              @db.Decimal(12, 2)
  unitCost      Decimal?             @db.Decimal(12, 2)
  totalCost     Decimal?             @db.Decimal(12, 2)
  referenceId   String?
  notes         String?              @db.Text
  performedBy   String?
  createdAt     DateTime             @default(now())

  @@map("stock_transactions")
}

enum FamilyRelation {
  SELF
  SPOUSE
  PARENT
  CHILD
  GRANDPARENT
  OTHER
}

model FamilyGroup {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String   @default("Tổ Ấm Yêu Thương")
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    FamilyMember[]

  @@map("family_groups")
}

model FamilyMember {
  id                  String         @id @default(uuid())
  familyGroupId       String
  familyGroup         FamilyGroup    @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?          @relation("LinkedFamilyUser", fields: [userId], references: [id], onDelete: SetNull)
  name                String
  relation            FamilyRelation @default(SELF)
  age                 Int?
  gender              String?        // 'male' | 'female' | 'other'
  heightCm            Decimal?       @db.Decimal(5, 1)
  weightKg            Decimal?       @db.Decimal(5, 1)
  activityLevel       ActivityLevel  @default(SEDENTARY)
  dailyCalories       Int?
  medicalConditions   String[]       @default([]) // e.g. ["TIỂU ĐƯỜNG TYPE 2", "CAO HUYẾT ÁP"]
  dietaryRestrictions String[]       @default([]) // e.g. ["DỊ ỨNG ĐẬU PHỘNG", "KHÔNG ĂN CAY"]
  isManaged           Boolean        @default(true) // true = người già/trẻ nhỏ tạo hồ sơ trực tiếp
  avatar              String?
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("family_members")
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model PaymentTransaction {
  id            String                   @id @default(cuid())
  orderId       String
  order         Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider      String                   // 'SEPAY', 'STRIPE', 'COD', 'MOCK'
  providerTxId  String?                  @unique
  amount        Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("VND")
  status        PaymentTransactionStatus @default(PENDING)
  metadata      Json?
  expiresAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([orderId])
  @@map("payment_transactions")
}
